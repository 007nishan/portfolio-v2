  "fcc_description": "<p>Given an array of your login logs, determine whether you have met your digital detox goal.</p>\n<p>Each log is a string in the format <code>\"YYYY-MM-DD HH:mm:ss\"</code>.</p>\n<p>You have met your digital detox goal if both of the following statements are true:</p>\n<ul>\n<li>You logged in no more than once within any four-hour period.</li>\n<li>You logged in no more than 2 times on any single day.</li>\n</ul>",
  "fcc_js_tests": "[{\"text\": \"<p><code>digitalDetox([\\\"2026-02-01 08:00:00\\\", \\\"2026-02-01 12:30:00\\\"])</code> should return <code>true</code>.</p>\", \"testString\": \"assert.isTrue(digitalDetox([\\\"2026-02-01 08:00:00\\\", \\\"2026-02-01 12:30:00\\\"]));\"}, {\"text\": \"<p><code>digitalDetox([\\\"2026-02-01 04:00:00\\\", \\\"2026-02-01 07:30:00\\\"])</code> should return <code>false</code>.</p>\", \"testString\": \"assert.isFalse(digitalDetox([\\\"2026-02-01 04:00:00\\\", \\\"2026-02-01 07:30:00\\\"]));\"}, {\"text\": \"<p><code>digitalDetox([\\\"2026-01-31 08:21:30\\\", \\\"2026-01-31 14:30:00\\\", \\\"2026-02-01 08:00:00\\\", \\\"2026-02-01 12:30:00\\\"])</code> should return <code>true</code>.</p>\", \"testString\": \"assert.isTrue(digitalDetox([\\\"2026-01-31 08:21:30\\\", \\\"2026-01-31 14:30:00\\\", \\\"2026-02-01 08:00:00\\\", \\\"2026-02-01 12:30:00\\\"]));\"}, {\"text\": \"<p><code>digitalDetox([\\\"2026-01-31 10:40:21\\\", \\\"2026-01-31 15:19:41\\\", \\\"2026-01-31 21:49:50\\\", \\\"2026-02-01 09:30:00\\\"])</code> should return <code>false</code>.</p>\", \"testString\": \"assert.isFalse(digitalDetox([\\\"2026-01-31 10:40:21\\\", \\\"2026-01-31 15:19:41\\\", \\\"2026-01-31 21:49:50\\\", \\\"2026-02-01 09:30:00\\\"]));\"}, {\"text\": \"<p><code>digitalDetox([\\\"2026-02-05 10:00:00\\\", \\\"2026-02-01 09:00:00\\\", \\\"2026-02-03 22:15:00\\\", \\\"2026-02-02 12:10:00\\\", \\\"2026-02-02 07:15:00\\\", \\\"2026-02-04 09:45:00\\\", \\\"2026-02-01 16:50:00\\\", \\\"2026-02-03 09:30:00\\\"])</code> should return <code>true</code>.</p>\", \"testString\": \"assert.isTrue(digitalDetox([\\\"2026-02-05 10:00:00\\\", \\\"2026-02-01 09:00:00\\\", \\\"2026-02-03 20:15:00\\\", \\\"2026-02-02 12:10:00\\\", \\\"2026-02-02 07:15:00\\\", \\\"2026-02-04 09:45:00\\\", \\\"2026-02-01 16:50:00\\\", \\\"2026-02-03 09:30:00\\\"]));\"}, {\"text\": \"<p><code>digitalDetox([\\\"2026-02-05 10:00:00\\\", \\\"2026-02-01 09:00:00\\\", \\\"2026-02-03 22:15:00\\\", \\\"2026-02-02 12:10:00\\\", \\\"2026-02-02 07:15:00\\\", \\\"2026-02-04 01:45:00\\\", \\\"2026-02-01 16:50:00\\\", \\\"2026-02-03 09:30:00\\\"])</code> should return <code>false</code>.</p>\", \"testString\": \"assert.isFalse(digitalDetox([\\\"2026-02-05 10:00:00\\\", \\\"2026-02-01 09:00:00\\\", \\\"2026-02-03 22:15:00\\\", \\\"2026-02-02 12:10:00\\\", \\\"2026-02-02 07:15:00\\\", \\\"2026-02-04 01:45:00\\\", \\\"2026-02-01 16:50:00\\\", \\\"2026-02-03 09:30:00\\\"]));\"}]",
  "fcc_py_tests": "[{\"text\": \"<p><code>digital_detox([\\\"2026-02-01 08:00:00\\\", \\\"2026-02-01 12:30:00\\\"])</code> should return <code>True</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertIs(digital_detox([\\\"2026-02-01 08:00:00\\\", \\\"2026-02-01 12:30:00\\\"]), True)`)\\n}})\"}, {\"text\": \"<p><code>digital_detox([\\\"2026-02-01 04:00:00\\\", \\\"2026-02-01 07:30:00\\\"])</code> should return <code>False</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertIs(digital_detox([\\\"2026-02-01 04:00:00\\\", \\\"2026-02-01 07:30:00\\\"]), False)`)\\n}})\"}, {\"text\": \"<p><code>digital_detox([\\\"2026-01-31 08:21:30\\\", \\\"2026-01-31 14:30:00\\\", \\\"2026-02-01 08:00:00\\\", \\\"2026-02-01 12:30:00\\\"])</code> should return <code>True</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertIs(digital_detox([\\\"2026-01-31 08:21:30\\\", \\\"2026-01-31 14:30:00\\\", \\\"2026-02-01 08:00:00\\\", \\\"2026-02-01 12:30:00\\\"]), True)`)\\n}})\"}, {\"text\": \"<p><code>digital_detox([\\\"2026-01-31 10:40:21\\\", \\\"2026-01-31 15:19:41\\\", \\\"2026-01-31 21:49:50\\\", \\\"2026-02-01 09:30:00\\\"])</code> should return <code>False</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertIs(digital_detox([\\\"2026-01-31 10:40:21\\\", \\\"2026-01-31 15:19:41\\\", \\\"2026-01-31 21:49:50\\\", \\\"2026-02-01 09:30:00\\\"]), False)`)\\n}})\"}, {\"text\": \"<p><code>digital_detox([\\\"2026-02-05 10:00:00\\\", \\\"2026-02-01 09:00:00\\\", \\\"2026-02-03 22:15:00\\\", \\\"2026-02-02 12:10:00\\\", \\\"2026-02-02 07:15:00\\\", \\\"2026-02-04 09:45:00\\\", \\\"2026-02-01 16:50:00\\\", \\\"2026-02-03 09:30:00\\\"])</code> should return <code>True</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertIs(digital_detox([\\\"2026-02-05 10:00:00\\\", \\\"2026-02-01 09:00:00\\\", \\\"2026-02-03 22:15:00\\\", \\\"2026-02-02 12:10:00\\\", \\\"2026-02-02 07:15:00\\\", \\\"2026-02-04 09:45:00\\\", \\\"2026-02-01 16:50:00\\\", \\\"2026-02-03 09:30:00\\\"]), True)`)\\n}})\"}, {\"text\": \"<p><code>digital_detox([\\\"2026-02-05 10:00:00\\\", \\\"2026-02-01 09:00:00\\\", \\\"2026-02-03 22:15:00\\\", \\\"2026-02-02 12:10:00\\\", \\\"2026-02-02 07:15:00\\\", \\\"2026-02-04 01:45:00\\\", \\\"2026-02-01 16:50:00\\\", \\\"2026-02-03 09:30:00\\\"])</code> should return <code>False</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertIs(digital_detox([\\\"2026-02-05 10:00:00\\\", \\\"2026-02-01 09:00:00\\\", \\\"2026-02-03 22:15:00\\\", \\\"2026-02-02 12:10:00\\\", \\\"2026-02-02 07:15:00\\\", \\\"2026-02-04 01:45:00\\\", \\\"2026-02-01 16:50:00\\\", \\\"2026-02-03 09:30:00\\\"]), False)`)\\n}})\"}]",
