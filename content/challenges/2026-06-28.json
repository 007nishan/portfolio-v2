  "fcc_description": "<p>Given a matrix of strings representing pieces on a game grid, determine if any player has three in a row.</p>\n<ul>\n<li>Each cell contains <code>\"R\"</code>, <code>\"Y\"</code>, or <code>\"\"</code> (empty string).</li>\n<li>Three in a row means three consecutive non-empty cells of the same type horizontally, vertically, or diagonally.</li>\n</ul>\n<p>Return:</p>\n<ul>\n<li>A flat array with the winner and the coordinates of their three winning cells in the format: <code>[\"R\", [0,2], [1,3], [2,4]]</code>. Coordinates are returned top-to-bottom, then left-to-right.</li>\n<li>An empty array if there is no winner.</li>\n</ul>",
  "fcc_js_tests": "[{\"text\": \"<p><code>connectThree([[\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\"], [\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\"], [\\\"\\\", \\\"Y\\\", \\\"\\\", \\\"\\\"], [\\\"Y\\\", \\\"R\\\", \\\"R\\\", \\\"R\\\"]])</code> should return <code>[\\\"R\\\", [3, 1], [3, 2], [3, 3]]</code>.</p>\", \"testString\": \"assert.deepEqual(connectThree([[\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\"], [\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\"], [\\\"\\\", \\\"Y\\\", \\\"\\\", \\\"\\\"], [\\\"Y\\\", \\\"R\\\", \\\"R\\\", \\\"R\\\"]]), [\\\"R\\\", [3, 1], [3, 2], [3, 3]]);\"}, {\"text\": \"<p><code>connectThree([[\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\"], [\\\"\\\", \\\"Y\\\", \\\"Y\\\", \\\"\\\"], [\\\"\\\", \\\"Y\\\", \\\"R\\\", \\\"R\\\"], [\\\"\\\", \\\"Y\\\", \\\"R\\\", \\\"R\\\"]])</code> should return <code>[\\\"Y\\\", [1, 1], [2, 1], [3, 1]]</code>.</p>\", \"testString\": \"assert.deepEqual(connectThree([[\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\"], [\\\"\\\", \\\"Y\\\", \\\"Y\\\", \\\"\\\"], [\\\"\\\", \\\"Y\\\", \\\"R\\\", \\\"R\\\"], [\\\"\\\", \\\"Y\\\", \\\"R\\\", \\\"R\\\"]]), [\\\"Y\\\", [1, 1], [2, 1], [3, 1]]);\"}, {\"text\": \"<p><code>connectThree([[\\\"\\\", \\\"\\\", \\\"Y\\\", \\\"R\\\"], [\\\"\\\", \\\"Y\\\", \\\"R\\\", \\\"Y\\\"], [\\\"\\\", \\\"R\\\", \\\"Y\\\", \\\"R\\\"], [\\\"\\\", \\\"R\\\", \\\"Y\\\", \\\"R\\\"]])</code> should return <code>[\\\"R\\\", [0, 3], [1, 2], [2, 1]]</code>.</p>\", \"testString\": \"assert.deepEqual(connectThree([[\\\"\\\", \\\"\\\", \\\"Y\\\", \\\"R\\\"], [\\\"\\\", \\\"Y\\\", \\\"R\\\", \\\"Y\\\"], [\\\"\\\", \\\"R\\\", \\\"Y\\\", \\\"R\\\"], [\\\"\\\", \\\"R\\\", \\\"Y\\\", \\\"R\\\"]]), [\\\"R\\\", [0, 3], [1, 2], [2, 1]]);\"}, {\"text\": \"<p><code>connectThree([[\\\"\\\", \\\"Y\\\", \\\"\\\", \\\"\\\"], [\\\"\\\", \\\"Y\\\", \\\"Y\\\", \\\"\\\"], [\\\"\\\", \\\"R\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"R\\\", \\\"Y\\\", \\\"R\\\"]])</code> should return <code>[\\\"Y\\\", [0, 1], [1, 2], [2, 3]]</code>.</p>\", \"testString\": \"assert.deepEqual(connectThree([[\\\"\\\", \\\"Y\\\", \\\"\\\", \\\"\\\"], [\\\"\\\", \\\"Y\\\", \\\"Y\\\", \\\"\\\"], [\\\"\\\", \\\"R\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"R\\\", \\\"Y\\\", \\\"R\\\"]]), [\\\"Y\\\", [0, 1], [1, 2], [2, 3]]);\"}, {\"text\": \"<p><code>connectThree([[\\\"Y\\\", \\\"R\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"Y\\\", \\\"Y\\\", \\\"R\\\"], [\\\"Y\\\", \\\"R\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"Y\\\", \\\"Y\\\", \\\"R\\\"]])</code> should return <code>[]</code>.</p>\", \"testString\": \"assert.deepEqual(connectThree([[\\\"Y\\\", \\\"R\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"Y\\\", \\\"Y\\\", \\\"R\\\"], [\\\"Y\\\", \\\"R\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"Y\\\", \\\"Y\\\", \\\"R\\\"]]), []);\"}]",
  "fcc_py_tests": "[{\"text\": \"<p><code>connect_three([[\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\"], [\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\"], [\\\"\\\", \\\"Y\\\", \\\"\\\", \\\"\\\"], [\\\"Y\\\", \\\"R\\\", \\\"R\\\", \\\"R\\\"]])</code> should return <code>[\\\"R\\\", [3, 1], [3, 2], [3, 3]]</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertEqual(connect_three([[\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\"], [\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\"], [\\\"\\\", \\\"Y\\\", \\\"\\\", \\\"\\\"], [\\\"Y\\\", \\\"R\\\", \\\"R\\\", \\\"R\\\"]]), [\\\"R\\\", [3, 1], [3, 2], [3, 3]])`)\\n}})\"}, {\"text\": \"<p><code>connect_three([[\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\"], [\\\"\\\", \\\"Y\\\", \\\"Y\\\", \\\"\\\"], [\\\"\\\", \\\"Y\\\", \\\"R\\\", \\\"R\\\"], [\\\"\\\", \\\"Y\\\", \\\"R\\\", \\\"R\\\"]])</code> should return <code>[\\\"Y\\\", [1, 1], [2, 1], [3, 1]]</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertEqual(connect_three([[\\\"\\\", \\\"\\\", \\\"\\\", \\\"\\\"], [\\\"\\\", \\\"Y\\\", \\\"Y\\\", \\\"\\\"], [\\\"\\\", \\\"Y\\\", \\\"R\\\", \\\"R\\\"], [\\\"\\\", \\\"Y\\\", \\\"R\\\", \\\"R\\\"]]), [\\\"Y\\\", [1, 1], [2, 1], [3, 1]])`)\\n}})\"}, {\"text\": \"<p><code>connect_three([[\\\"\\\", \\\"\\\", \\\"Y\\\", \\\"R\\\"], [\\\"\\\", \\\"Y\\\", \\\"R\\\", \\\"Y\\\"], [\\\"\\\", \\\"R\\\", \\\"Y\\\", \\\"R\\\"], [\\\"\\\", \\\"R\\\", \\\"Y\\\", \\\"R\\\"]])</code> should return <code>[\\\"R\\\", [0, 3], [1, 2], [2, 1]]</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertEqual(connect_three([[\\\"\\\", \\\"\\\", \\\"Y\\\", \\\"R\\\"], [\\\"\\\", \\\"Y\\\", \\\"R\\\", \\\"Y\\\"], [\\\"\\\", \\\"R\\\", \\\"Y\\\", \\\"R\\\"], [\\\"\\\", \\\"R\\\", \\\"Y\\\", \\\"R\\\"]]), [\\\"R\\\", [0, 3], [1, 2], [2, 1]])`)\\n}})\"}, {\"text\": \"<p><code>connect_three([[\\\"\\\", \\\"Y\\\", \\\"\\\", \\\"\\\"], [\\\"\\\", \\\"Y\\\", \\\"Y\\\", \\\"\\\"], [\\\"\\\", \\\"R\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"R\\\", \\\"Y\\\", \\\"R\\\"]])</code> should return <code>[\\\"Y\\\", [0, 1], [1, 2], [2, 3]]</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertEqual(connect_three([[\\\"\\\", \\\"Y\\\", \\\"\\\", \\\"\\\"], [\\\"\\\", \\\"Y\\\", \\\"Y\\\", \\\"\\\"], [\\\"\\\", \\\"R\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"R\\\", \\\"Y\\\", \\\"R\\\"]]), [\\\"Y\\\", [0, 1], [1, 2], [2, 3]])`)\\n}})\"}, {\"text\": \"<p><code>connect_three([[\\\"Y\\\", \\\"R\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"Y\\\", \\\"Y\\\", \\\"R\\\"], [\\\"Y\\\", \\\"R\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"Y\\\", \\\"Y\\\", \\\"R\\\"]])</code> should return <code>[]</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertEqual(connect_three([[\\\"Y\\\", \\\"R\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"Y\\\", \\\"Y\\\", \\\"R\\\"], [\\\"Y\\\", \\\"R\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"Y\\\", \\\"Y\\\", \\\"R\\\"]]), [])`)\\n}})\"}]",
