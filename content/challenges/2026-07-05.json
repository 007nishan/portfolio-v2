  "fcc_description": "<p>Given a 2D grid, a starting position (<code>[row, col]</code>), and a new value, replace the value at the starting position and all connected cells of the same value with the new value.</p>\n<ul>\n<li>Cells are connected if they are adjacent horizontally or vertically (not diagonally).</li>\n</ul>\n<p>Return the updated grid.</p>",
  "fcc_js_tests": "[{\"text\": \"<p><code>bucketFill([[\\\"R\\\", \\\"G\\\"], [\\\"R\\\", \\\"G\\\"]], [0, 1], \\\"B\\\")</code> should return <code>[[\\\"R\\\", \\\"B\\\"], [\\\"R\\\", \\\"B\\\"]]</code>.</p>\", \"testString\": \"assert.deepEqual(bucketFill([[\\\"R\\\", \\\"G\\\"], [\\\"R\\\", \\\"G\\\"]], [0, 1], \\\"B\\\"), [[\\\"R\\\", \\\"B\\\"], [\\\"R\\\", \\\"B\\\"]]);\"}, {\"text\": \"<p><code>bucketFill([[\\\"Y\\\", \\\"G\\\", \\\"G\\\"], [\\\"Y\\\", \\\"Y\\\", \\\"Y\\\"], [\\\"B\\\", \\\"Y\\\", \\\"R\\\"]], [1, 2], \\\"B\\\")</code> should return <code>[[\\\"B\\\", \\\"G\\\", \\\"G\\\"], [\\\"B\\\", \\\"B\\\", \\\"B\\\"], [\\\"B\\\", \\\"B\\\", \\\"R\\\"]]</code>.</p>\", \"testString\": \"assert.deepEqual(bucketFill([[\\\"Y\\\", \\\"G\\\", \\\"G\\\"], [\\\"Y\\\", \\\"Y\\\", \\\"Y\\\"], [\\\"B\\\", \\\"Y\\\", \\\"R\\\"]], [1, 2], \\\"B\\\"), [[\\\"B\\\", \\\"G\\\", \\\"G\\\"], [\\\"B\\\", \\\"B\\\", \\\"B\\\"], [\\\"B\\\", \\\"B\\\", \\\"R\\\"]]);\"}, {\"text\": \"<p><code>bucketFill([[\\\"O\\\", \\\"O\\\", \\\"P\\\"], [\\\"P\\\", \\\"O\\\", \\\"O\\\"], [\\\"P\\\", \\\"P\\\", \\\"O\\\"]], [2, 0], \\\"R\\\")</code> should return <code>[[\\\"O\\\", \\\"O\\\", \\\"P\\\"], [\\\"R\\\", \\\"O\\\", \\\"O\\\"], [\\\"R\\\", \\\"R\\\", \\\"O\\\"]]</code>.</p>\", \"testString\": \"assert.deepEqual(bucketFill([[\\\"O\\\", \\\"O\\\", \\\"P\\\"], [\\\"P\\\", \\\"O\\\", \\\"O\\\"], [\\\"P\\\", \\\"P\\\", \\\"O\\\"]], [2, 0], \\\"R\\\"), [[\\\"O\\\", \\\"O\\\", \\\"P\\\"], [\\\"R\\\", \\\"O\\\", \\\"O\\\"], [\\\"R\\\", \\\"R\\\", \\\"O\\\"]]);\"}, {\"text\": \"<p><code>bucketFill([[\\\"T\\\", \\\"T\\\", \\\"R\\\", \\\"T\\\"], [\\\"R\\\", \\\"T\\\", \\\"R\\\", \\\"T\\\"], [\\\"R\\\", \\\"T\\\", \\\"R\\\", \\\"T\\\"], [\\\"T\\\", \\\"T\\\", \\\"T\\\", \\\"T\\\"]], [0, 3], \\\"Y\\\")</code> should return <code>[[\\\"Y\\\", \\\"Y\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"Y\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"Y\\\", \\\"R\\\", \\\"Y\\\"], [\\\"Y\\\", \\\"Y\\\", \\\"Y\\\", \\\"Y\\\"]]</code>.</p>\", \"testString\": \"assert.deepEqual(bucketFill([[\\\"T\\\", \\\"T\\\", \\\"R\\\", \\\"T\\\"], [\\\"R\\\", \\\"T\\\", \\\"R\\\", \\\"T\\\"], [\\\"R\\\", \\\"T\\\", \\\"R\\\", \\\"T\\\"], [\\\"T\\\", \\\"T\\\", \\\"T\\\", \\\"T\\\"]], [0, 3], \\\"Y\\\"), [[\\\"Y\\\", \\\"Y\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"Y\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"Y\\\", \\\"R\\\", \\\"Y\\\"], [\\\"Y\\\", \\\"Y\\\", \\\"Y\\\", \\\"Y\\\"]]);\"}, {\"text\": \"<p><code>bucketFill([[\\\"G\\\", \\\"B\\\", \\\"G\\\", \\\"B\\\"], [\\\"R\\\", \\\"B\\\", \\\"B\\\", \\\"G\\\"], [\\\"B\\\", \\\"G\\\", \\\"B\\\", \\\"R\\\"], [\\\"B\\\", \\\"G\\\", \\\"G\\\", \\\"B\\\"]], [2, 2], \\\"G\\\")</code> should return <code>[[\\\"G\\\", \\\"G\\\", \\\"G\\\", \\\"B\\\"], [\\\"R\\\", \\\"G\\\", \\\"G\\\", \\\"G\\\"], [\\\"B\\\", \\\"G\\\", \\\"G\\\", \\\"R\\\"], [\\\"B\\\", \\\"G\\\", \\\"G\\\", \\\"B\\\"]]</code>.</p>\", \"testString\": \"assert.deepEqual(bucketFill([[\\\"G\\\", \\\"B\\\", \\\"G\\\", \\\"B\\\"], [\\\"R\\\", \\\"B\\\", \\\"B\\\", \\\"G\\\"], [\\\"B\\\", \\\"G\\\", \\\"B\\\", \\\"R\\\"], [\\\"B\\\", \\\"G\\\", \\\"G\\\", \\\"B\\\"]], [2, 2], \\\"G\\\"), [[\\\"G\\\", \\\"G\\\", \\\"G\\\", \\\"B\\\"], [\\\"R\\\", \\\"G\\\", \\\"G\\\", \\\"G\\\"], [\\\"B\\\", \\\"G\\\", \\\"G\\\", \\\"R\\\"], [\\\"B\\\", \\\"G\\\", \\\"G\\\", \\\"B\\\"]]);\"}]",
  "fcc_py_tests": "[{\"text\": \"<p><code>bucket_fill([[\\\"R\\\", \\\"G\\\"], [\\\"R\\\", \\\"G\\\"]], [0, 1], \\\"B\\\")</code> should return <code>[[\\\"R\\\", \\\"B\\\"], [\\\"R\\\", \\\"B\\\"]]</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertEqual(bucket_fill([[\\\"R\\\", \\\"G\\\"], [\\\"R\\\", \\\"G\\\"]], [0, 1], \\\"B\\\"), [[\\\"R\\\", \\\"B\\\"], [\\\"R\\\", \\\"B\\\"]])`)\\n}})\"}, {\"text\": \"<p><code>bucket_fill([[\\\"Y\\\", \\\"G\\\", \\\"G\\\"], [\\\"Y\\\", \\\"Y\\\", \\\"Y\\\"], [\\\"B\\\", \\\"Y\\\", \\\"R\\\"]], [1, 2], \\\"B\\\")</code> should return <code>[[\\\"B\\\", \\\"G\\\", \\\"G\\\"], [\\\"B\\\", \\\"B\\\", \\\"B\\\"], [\\\"B\\\", \\\"B\\\", \\\"R\\\"]]</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertEqual(bucket_fill([[\\\"Y\\\", \\\"G\\\", \\\"G\\\"], [\\\"Y\\\", \\\"Y\\\", \\\"Y\\\"], [\\\"B\\\", \\\"Y\\\", \\\"R\\\"]], [1, 2], \\\"B\\\"), [[\\\"B\\\", \\\"G\\\", \\\"G\\\"], [\\\"B\\\", \\\"B\\\", \\\"B\\\"], [\\\"B\\\", \\\"B\\\", \\\"R\\\"]])`)\\n}})\"}, {\"text\": \"<p><code>bucket_fill([[\\\"O\\\", \\\"O\\\", \\\"P\\\"], [\\\"P\\\", \\\"O\\\", \\\"O\\\"], [\\\"P\\\", \\\"P\\\", \\\"O\\\"]], [2, 0], \\\"R\\\")</code> should return <code>[[\\\"O\\\", \\\"O\\\", \\\"P\\\"], [\\\"R\\\", \\\"O\\\", \\\"O\\\"], [\\\"R\\\", \\\"R\\\", \\\"O\\\"]]</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertEqual(bucket_fill([[\\\"O\\\", \\\"O\\\", \\\"P\\\"], [\\\"P\\\", \\\"O\\\", \\\"O\\\"], [\\\"P\\\", \\\"P\\\", \\\"O\\\"]], [2, 0], \\\"R\\\"), [[\\\"O\\\", \\\"O\\\", \\\"P\\\"], [\\\"R\\\", \\\"O\\\", \\\"O\\\"], [\\\"R\\\", \\\"R\\\", \\\"O\\\"]])`)\\n}})\"}, {\"text\": \"<p><code>bucket_fill([[\\\"T\\\", \\\"T\\\", \\\"R\\\", \\\"T\\\"], [\\\"R\\\", \\\"T\\\", \\\"R\\\", \\\"T\\\"], [\\\"R\\\", \\\"T\\\", \\\"R\\\", \\\"T\\\"], [\\\"T\\\", \\\"T\\\", \\\"T\\\", \\\"T\\\"]], [0, 3], \\\"Y\\\")</code> should return <code>[[\\\"Y\\\", \\\"Y\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"Y\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"Y\\\", \\\"R\\\", \\\"Y\\\"], [\\\"Y\\\", \\\"Y\\\", \\\"Y\\\", \\\"Y\\\"]]</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertEqual(bucket_fill([[\\\"T\\\", \\\"T\\\", \\\"R\\\", \\\"T\\\"], [\\\"R\\\", \\\"T\\\", \\\"R\\\", \\\"T\\\"], [\\\"R\\\", \\\"T\\\", \\\"R\\\", \\\"T\\\"], [\\\"T\\\", \\\"T\\\", \\\"T\\\", \\\"T\\\"]], [0, 3], \\\"Y\\\"), [[\\\"Y\\\", \\\"Y\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"Y\\\", \\\"R\\\", \\\"Y\\\"], [\\\"R\\\", \\\"Y\\\", \\\"R\\\", \\\"Y\\\"], [\\\"Y\\\", \\\"Y\\\", \\\"Y\\\", \\\"Y\\\"]])`)\\n}})\"}, {\"text\": \"<p><code>bucket_fill([[\\\"G\\\", \\\"B\\\", \\\"G\\\", \\\"B\\\"], [\\\"R\\\", \\\"B\\\", \\\"B\\\", \\\"G\\\"], [\\\"B\\\", \\\"G\\\", \\\"B\\\", \\\"R\\\"], [\\\"B\\\", \\\"G\\\", \\\"G\\\", \\\"B\\\"]], [2, 2], \\\"G\\\")</code> should return <code>[[\\\"G\\\", \\\"G\\\", \\\"G\\\", \\\"B\\\"], [\\\"R\\\", \\\"G\\\", \\\"G\\\", \\\"G\\\"], [\\\"B\\\", \\\"G\\\", \\\"G\\\", \\\"R\\\"], [\\\"B\\\", \\\"G\\\", \\\"G\\\", \\\"B\\\"]]</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertEqual(bucket_fill([[\\\"G\\\", \\\"B\\\", \\\"G\\\", \\\"B\\\"], [\\\"R\\\", \\\"B\\\", \\\"B\\\", \\\"G\\\"], [\\\"B\\\", \\\"G\\\", \\\"B\\\", \\\"R\\\"], [\\\"B\\\", \\\"G\\\", \\\"G\\\", \\\"B\\\"]], [2, 2], \\\"G\\\"), [[\\\"G\\\", \\\"G\\\", \\\"G\\\", \\\"B\\\"], [\\\"R\\\", \\\"G\\\", \\\"G\\\", \\\"G\\\"], [\\\"B\\\", \\\"G\\\", \\\"G\\\", \\\"R\\\"], [\\\"B\\\", \\\"G\\\", \\\"G\\\", \\\"B\\\"]])`)\\n}})\"}]",
