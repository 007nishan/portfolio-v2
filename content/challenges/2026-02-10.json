  "fcc_description": "<p>Given an array of finish times for a cross-country ski race, convert them into times behind the winner.</p>\n<ul>\n<li>Given times are strings in <code>\"H:MM:SS\"</code> format.</li>\n<li>Given times will be in order from fastest to slowest.</li>\n<li>The winners time (fastest time) should correspond to <code>\"0\"</code>.</li>\n<li>Each other time should show the time behind the winner, in the format <code>\"+M:SS\"</code>.</li>\n</ul>\n<p>For example, given <code>[\"1:25:32\", \"1:26:10\", \"1:27:05\"]</code>, return <code>[\"0\", \"+0:38\", \"+1:33\"]</code>.</p>",
  "fcc_js_tests": "[{\"text\": \"<p><code>getRelativeResults([\\\"1:25:32\\\", \\\"1:26:10\\\", \\\"1:27:05\\\"])</code> should return <code>[\\\"0\\\", \\\"+0:38\\\", \\\"+1:33\\\"]</code>.</p>\", \"testString\": \"assert.deepEqual(getRelativeResults([\\\"1:25:32\\\", \\\"1:26:10\\\", \\\"1:27:05\\\"]), [\\\"0\\\", \\\"+0:38\\\", \\\"+1:33\\\"]);\"}, {\"text\": \"<p><code>getRelativeResults([\\\"1:00:01\\\", \\\"1:00:05\\\", \\\"1:00:10\\\"])</code> should return <code>[\\\"0\\\", \\\"+0:04\\\", \\\"+0:09\\\"]</code>.</p>\", \"testString\": \"assert.deepEqual(getRelativeResults([\\\"1:00:01\\\", \\\"1:00:05\\\", \\\"1:00:10\\\"]), [\\\"0\\\", \\\"+0:04\\\", \\\"+0:09\\\"]);\"}, {\"text\": \"<p><code>getRelativeResults([\\\"1:10:06\\\", \\\"1:10:23\\\", \\\"1:10:48\\\", \\\"1:12:11\\\"])</code> should return <code>[\\\"0\\\", \\\"+0:17\\\", \\\"+0:42\\\", \\\"+2:05\\\"]</code>.</p>\", \"testString\": \"assert.deepEqual(getRelativeResults([\\\"1:10:06\\\", \\\"1:10:23\\\", \\\"1:10:48\\\", \\\"1:12:11\\\"]), [\\\"0\\\", \\\"+0:17\\\", \\\"+0:42\\\", \\\"+2:05\\\"]);\"}, {\"text\": \"<p><code>getRelativeResults([\\\"0:49:13\\\", \\\"0:49:15\\\", \\\"0:50:14\\\", \\\"0:51:30\\\", \\\"0:51:58\\\", \\\"0:52:16\\\", \\\"0:53:12\\\", \\\"0:53:31\\\", \\\"0:56:19\\\", \\\"1:02:20\\\"])</code> should return <code>[\\\"0\\\", \\\"+0:02\\\", \\\"+1:01\\\", \\\"+2:17\\\", \\\"+2:45\\\", \\\"+3:03\\\", \\\"+3:59\\\", \\\"+4:18\\\", \\\"+7:06\\\", \\\"+13:07\\\"]</code>.</p>\", \"testString\": \"assert.deepEqual(getRelativeResults([\\\"0:49:13\\\", \\\"0:49:15\\\", \\\"0:50:14\\\", \\\"0:51:30\\\", \\\"0:51:58\\\", \\\"0:52:16\\\", \\\"0:53:12\\\", \\\"0:53:31\\\", \\\"0:56:19\\\", \\\"1:02:20\\\"]), [\\\"0\\\", \\\"+0:02\\\", \\\"+1:01\\\", \\\"+2:17\\\", \\\"+2:45\\\", \\\"+3:03\\\", \\\"+3:59\\\", \\\"+4:18\\\", \\\"+7:06\\\", \\\"+13:07\\\"]);\"}, {\"text\": \"<p><code>getRelativeResults([\\\"2:01:15\\\", \\\"2:10:45\\\", \\\"2:10:53\\\", \\\"2:11:04\\\", \\\"2:11:55\\\", \\\"2:13:27\\\", \\\"2:14:30\\\", \\\"2:15:10\\\"])</code> should return <code>[\\\"0\\\", \\\"+9:30\\\", \\\"+9:38\\\", \\\"+9:49\\\", \\\"+10:40\\\", \\\"+12:12\\\", \\\"+13:15\\\", \\\"+13:55\\\"]</code>.</p>\", \"testString\": \"assert.deepEqual(getRelativeResults([\\\"2:01:15\\\", \\\"2:10:45\\\", \\\"2:10:53\\\", \\\"2:11:04\\\", \\\"2:11:55\\\", \\\"2:13:27\\\", \\\"2:14:30\\\", \\\"2:15:10\\\"]), [\\\"0\\\", \\\"+9:30\\\", \\\"+9:38\\\", \\\"+9:49\\\", \\\"+10:40\\\", \\\"+12:12\\\", \\\"+13:15\\\", \\\"+13:55\\\"]);\"}]",
  "fcc_py_tests": "[{\"text\": \"<p><code>get_relative_results([\\\"1:25:32\\\", \\\"1:26:10\\\", \\\"1:27:05\\\"])</code> should return <code>[\\\"0\\\", \\\"+0:38\\\", \\\"+1:33\\\"]</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertEqual(get_relative_results([\\\"1:25:32\\\", \\\"1:26:10\\\", \\\"1:27:05\\\"]), [\\\"0\\\", \\\"+0:38\\\", \\\"+1:33\\\"])`)\\n}})\"}, {\"text\": \"<p><code>get_relative_results([\\\"1:00:01\\\", \\\"1:00:05\\\", \\\"1:00:10\\\"])</code> should return <code>[\\\"0\\\", \\\"+0:04\\\", \\\"+0:09\\\"]</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertEqual(get_relative_results([\\\"1:00:01\\\", \\\"1:00:05\\\", \\\"1:00:10\\\"]), [\\\"0\\\", \\\"+0:04\\\", \\\"+0:09\\\"])`)\\n}})\"}, {\"text\": \"<p><code>get_relative_results([\\\"1:10:06\\\", \\\"1:10:23\\\", \\\"1:10:48\\\", \\\"1:12:11\\\"])</code> should return <code>[\\\"0\\\", \\\"+0:17\\\", \\\"+0:42\\\", \\\"+2:05\\\"]</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertEqual(get_relative_results([\\\"1:10:06\\\", \\\"1:10:23\\\", \\\"1:10:48\\\", \\\"1:12:11\\\"]), [\\\"0\\\", \\\"+0:17\\\", \\\"+0:42\\\", \\\"+2:05\\\"])`)\\n}})\"}, {\"text\": \"<p><code>get_relative_results([\\\"0:49:13\\\", \\\"0:49:15\\\", \\\"0:50:14\\\", \\\"0:51:30\\\", \\\"0:51:58\\\", \\\"0:52:16\\\", \\\"0:53:12\\\", \\\"0:53:31\\\", \\\"0:56:19\\\", \\\"1:02:20\\\"])</code> should return <code>[\\\"0\\\", \\\"+0:02\\\", \\\"+1:01\\\", \\\"+2:17\\\", \\\"+2:45\\\", \\\"+3:03\\\", \\\"+3:59\\\", \\\"+4:18\\\", \\\"+7:06\\\", \\\"+13:07\\\"]</code>.</p>\", \"testString\": \"({test: () => { runPython(`\\nfrom unittest import TestCase\\nTestCase().assertEqual(get_relative_results([\\\"0:49:13\\\", \\\"0:49:15\\\", \\\"0:50:14\\\", \\\"0:51:30\\\", \\\"0:51:58\\\", \\\"0:52:16\\\", \\\"0:53:12\\\", \\\"0:53:31\\\", \\\"0:56:19